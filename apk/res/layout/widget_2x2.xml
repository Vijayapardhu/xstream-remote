<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07080B"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Xstream Remote"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:fontFamily="sans-serif"
        android:text="Tap a key to control your TV"
        android:textColor="#9AA5B1"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="10px"
        android:layout_marginBottom="10px"
        android:background="#2A2E3A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btn_power"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4px"
            android:layout_weight="1"
            android:background="@drawable/widget_key_bg"
            android:fontFamily="sans-serif-medium"
            android:padding="8px"
            android:text="Power"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4px"
            android:layout_weight="1"
            android:background="@drawable/widget_key_bg"
            android:fontFamily="sans-serif-medium"
            android:padding="8px"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4px"
            android:layout_weight="1"
            android:background="@drawable/widget_key_bg"
            android:fontFamily="sans-serif-medium"
            android:padding="8px"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_ok"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="4px"
            android:layout_weight="1"
            android:background="@drawable/widget_key_bg"
            android:fontFamily="sans-serif-medium"
            android:padding="8px"
            android:text="OK"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
